// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servers     Server[]
  activities  Activity[]

  @@map("users")
}

model Server {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      ServerStatus @default(OFFLINE)
  gameType    GameType
  version     String
  port        Int      @unique
  maxPlayers  Int      @default(20)
  motd        String?

  // Resource allocation
  cpuLimit    Int      @default(2000) // Millicores
  memoryLimit Int      @default(2048) // MB
  diskLimit   Int      @default(10240) // MB

  // Docker configuration
  dockerImage String   @default("itzg/minecraft-server")
  dockerPorts Json?    // Store port mappings as JSON

  // Server configuration
  config      Json?    // Store server-specific config as JSON

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  instances   ServerInstance[]
  backups     Backup[]
  activities  Activity[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("servers")
}

model ServerInstance {
  id          String   @id @default(cuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  containerId String?  // Docker container ID
  status      InstanceStatus @default(STOPPED)

  // Runtime metrics
  cpuUsage    Float?
  memoryUsage Float?
  diskUsage   Float?
  uptime      Int?     // seconds

  // Network
  bytesIn     BigInt?  @default(0)
  bytesOut    BigInt?  @default(0)

  startedAt   DateTime?
  stoppedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("server_instances")
}

model Backup {
  id          String   @id @default(cuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  name        String
  description String?
  filePath    String
  fileSize    BigInt
  status      BackupStatus @default(PENDING)

  createdAt   DateTime @default(now())

  @@map("backups")
}

model Activity {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  serverId    String?
  server      Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)

  action      String   // e.g., "SERVER_START", "SERVER_STOP", "BACKUP_CREATE"
  details     Json?    // Additional details about the action
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@map("activities")
}

model ResourceUsage {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  cpuUsage    Float
  memoryUsage Float
  diskUsage   Float
  networkIn   BigInt
  networkOut  BigInt
  players     Int      @default(0)

  timestamp DateTime @default(now())

  @@map("resource_usage")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ServerStatus {
  ONLINE
  OFFLINE
  STARTING
  STOPPING
  ERROR
}

enum InstanceStatus {
  RUNNING
  STOPPED
  PAUSED
  ERROR
}

enum GameType {
  MINECRAFT_JAVA
  MINECRAFT_BEDROCK
  MINECRAFT_PAPER
  MINECRAFT_SPIGOT
  MINECRAFT_BUNGEE
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}