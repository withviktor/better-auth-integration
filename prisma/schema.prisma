// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  apikeys Apikey[]

  role        String?
  banned      Boolean?
  banReason   String?
  banExpires  DateTime?
  members     Member[]
  invitations Invitation[]

  // Game server hosting specific fields
  gameServers GameServer[]
  serverTemplates ServerTemplate[]
  serverBackups ServerBackup[]
  credits     Int      @default(0)
  maxServers  Int      @default(5)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Apikey {
  id                  String    @id
  name                String?
  start               String?
  prefix              String?
  key                 String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?
  rateLimitEnabled    Boolean?
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@map("apikey")
}

model Organization {
  id          String       @id
  name        String
  slug        String?
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  teams Team[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  teamId String?

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  teamId String?

  @@map("invitation")
}

model Team {
  id             String       @id
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?

  @@map("team")
}

// Game Server Management Models
model GameServer {
  id          String @id @default(uuid())
  name        String
  description String?
  
  // Server Configuration
  gameType    String // minecraft, valheim, etc.
  version     String
  port        Int
  maxPlayers  Int    @default(20)
  
  // Docker Configuration  
  containerId String?
  imageName   String
  dockerPort  Int?
  
  // Server Status
  status      ServerStatus @default(STOPPED)
  cpuUsage    Float?       @default(0)
  memoryUsage Float?       @default(0)
  diskUsage   Float?       @default(0)
  
  // Ownership
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Configuration
  config      Json?
  environment Json?
  
  // File Management
  serverPath  String?
  backups     ServerBackup[]
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastStarted DateTime?
  lastStopped DateTime?
  
  // Relations
  template    ServerTemplate? @relation(fields: [templateId], references: [id])
  templateId  String?
  
  logs        ServerLog[]
  metrics     ServerMetric[]

  @@map("game_server")
}

model ServerTemplate {
  id          String @id @default(uuid())
  name        String
  description String?
  gameType    String
  version     String
  
  // Docker Configuration
  dockerImage String
  dockerfile  String?
  
  // Default Configuration
  defaultConfig Json?
  environment   Json?
  
  // Resource Limits
  minMemory     Int @default(512)   // MB
  maxMemory     Int @default(2048)  // MB
  minCpu        Float @default(0.5)
  maxCpu        Float @default(2.0)
  
  // Ownership
  isPublic      Boolean @default(false)
  userId        String?
  user          User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Usage
  gameServers   GameServer[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("server_template")
}

model ServerBackup {
  id           String @id @default(uuid())
  name         String
  description  String?
  
  // Server Reference
  gameServerId String
  gameServer   GameServer @relation(fields: [gameServerId], references: [id], onDelete: Cascade)
  
  // Backup Details
  filePath     String
  fileSize     BigInt
  backupType   BackupType @default(MANUAL)
  
  // Ownership
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  
  @@map("server_backup")
}

model ServerLog {
  id           String @id @default(uuid())
  
  // Server Reference
  gameServerId String
  gameServer   GameServer @relation(fields: [gameServerId], references: [id], onDelete: Cascade)
  
  // Log Details
  level        LogLevel @default(INFO)
  message      String
  source       String?  // console, system, docker, etc.
  
  createdAt    DateTime @default(now())

  @@map("server_log")
}

model ServerMetric {
  id           String @id @default(uuid())
  
  // Server Reference
  gameServerId String
  gameServer   GameServer @relation(fields: [gameServerId], references: [id], onDelete: Cascade)
  
  // Metrics
  cpuUsage     Float
  memoryUsage  Float
  diskUsage    Float
  networkIn    Float?
  networkOut   Float?
  playerCount  Int?
  
  createdAt    DateTime @default(now())

  @@map("server_metric")
}

// Node Management for Multi-Server Setup
model Node {
  id          String @id @default(uuid())
  name        String
  hostname    String
  ipAddress   String
  port        Int    @default(2376)
  
  // Node Status
  status      NodeStatus @default(OFFLINE)
  cpuCores    Int
  totalMemory BigInt // bytes
  totalDisk   BigInt // bytes
  
  // Docker Configuration
  dockerVersion String?
  
  // Resource Usage
  usedMemory  BigInt @default(0)
  usedDisk    BigInt @default(0)
  
  // Authentication
  tlsCert     String?
  tlsKey      String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastPing    DateTime?

  @@unique([hostname])
  @@unique([ipAddress, port])
  @@map("node")
}

// Enums
enum ServerStatus {
  STOPPED
  STARTING
  RUNNING
  STOPPING
  CRASHED
  INSTALLING
  UPDATING
}

enum NodeStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}

enum BackupType {
  MANUAL
  SCHEDULED
  AUTO_SAVE
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}
